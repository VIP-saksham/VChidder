# Required — Telegram API (my.telegram.org)
API_ID=21192304
API_HASH=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Required — Bot token (@BotFather)
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Required — Pyrogram string session of the assistant (player) account
SESSION_STRING=BQFDXnAAxxxxxxxxxxxxxxxxxxxx

# Required — Your Telegram user id (full access)
OWNER_ID=5635324483

# Optional — extra sudo ids, comma separated
SUDO_USERS=

# Optional — log group/channel id where events get posted
LOG_GROUP_ID=-1004495764762

# Optional — join VC with MIC OFF badge (1 = yes, hidden streaming)
MUTED_MUSIC=1

# Optional — presence keepalive refresh seconds (default 1500 = 25 min)
MIC_REFRESH=1500

# Optional — buttons links
CHANNEL_LINK=https://t.me/TheHellBots
SUPPORT_LINK=https://t.me/SUNSHINE_GC
OWNER_LINK=https://t.me/Truenakshu
